{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/monadrome/omha/schemas/providers.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "profiles"],
  "properties": {
    "version": { "const": 1 },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/profile" }
    },
    "fallbackOrder": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$" },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxRetries": { "type": "integer", "minimum": 0, "maximum": 10 },
        "baseMs": { "type": "integer", "minimum": 0, "maximum": 60000 },
        "maxMs": { "type": "integer", "minimum": 0, "maximum": 3600000 },
        "jitter": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxRequests": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "maxTokens": { "type": "integer", "minimum": 0 },
        "maxCostUsd": { "type": "number", "minimum": 0 },
        "reserveTokens": { "type": "integer", "minimum": 0 },
        "reserveCostUsd": { "type": "number", "minimum": 0 }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "model"],
      "properties": {
        "name": { "$ref": "#/$defs/id" },
        "adapter": { "enum": ["claude", "codex", "kimi", "command", "fake"] },
        "command": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "args": { "type": "array", "items": { "type": "string" } },
        "sandboxCommand": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "sandboxArgs": { "type": "array", "items": { "type": "string" } },
        "sandboxWrite": { "type": "boolean" },
        "model": { "type": "string", "minLength": 1, "maxLength": 256 },
        "effort": { "enum": ["minimal", "low", "medium", "high", "xhigh", "max"] },
        "sandbox": { "enum": ["read-only", "workspace-write", "external"] },
        "timeoutMs": { "type": "integer", "minimum": 10, "maximum": 86400000 },
        "concurrency": { "type": "integer", "minimum": 1, "maximum": 64 },
        "maxOutputBytes": { "type": "integer", "minimum": 256, "maximum": 67108864 },
        "outputFormat": { "enum": ["text", "json", "jsonl"] },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["interactive", "headless", "tool-free", "read-only"] }
        },
        "envAllowlist": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
        },
        "fallback": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "retry": { "$ref": "#/$defs/retry" },
        "budget": { "$ref": "#/$defs/budget" },
        "circuit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "threshold": { "type": "integer", "minimum": 1, "maximum": 100 },
            "cooldownMs": { "type": "integer", "minimum": 10, "maximum": 3600000 }
          }
        },
        "responses": { "type": "array", "minItems": 1, "items": { "type": "object" } }
      }
    }
  }
}
