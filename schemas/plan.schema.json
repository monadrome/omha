{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "objective", "tasks"],
  "properties": {
    "version": { "const": 1 },
    "objective": { "type": "string", "minLength": 1, "maxLength": 100000 },
    "publicContext": { "type": "string", "maxLength": 1000000 },
    "parallelism": { "type": "integer", "minimum": 1, "maximum": 16 },
    "decision": { "type": "object" },
    "butterfly": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "handoff": { "type": "boolean", "default": true },
        "backend": { "enum": ["file", "auto", "cmux", "tmux"], "default": "file" },
        "maxHandoffs": { "type": "integer", "minimum": 0, "maximum": 3, "default": 3 },
        "maxObservations": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 256 },
        "forks": {
          "type": "object",
          "maxProperties": 256,
          "propertyNames": { "$ref": "providers.schema.json#/$defs/id" },
          "additionalProperties": {
            "allOf": [{ "$ref": "fork.schema.json" }, { "required": ["actionId"] }]
          }
        }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "read": { "type": "boolean" },
        "write": { "type": "boolean" },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["project", "worktree"] }
        },
        "maxTopics": { "type": "integer", "minimum": 1, "maximum": 16 },
        "maxBytes": { "type": "integer", "minimum": 256, "maximum": 16000 },
        "maxLines": { "type": "integer", "minimum": 5, "maximum": 200 },
        "ttlDays": { "type": "integer", "minimum": 1, "maximum": 365 }
      }
    },
    "supervision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stallMs": { "type": "integer", "minimum": 0, "maximum": 86400000 },
        "inputWaitMs": { "type": "integer", "minimum": 0, "maximum": 86400000 },
        "maxTakeovers": { "type": "integer", "minimum": 0, "maximum": 3 }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "prompt", "profile"],
        "properties": {
          "id": { "$ref": "providers.schema.json#/$defs/id" },
          "role": { "type": "string", "minLength": 1, "maxLength": 128 },
          "prompt": { "type": "string", "minLength": 1, "maxLength": 100000 },
          "profile": { "$ref": "providers.schema.json#/$defs/id" },
          "dependsOn": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "providers.schema.json#/$defs/id" }
          },
          "fallback": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "providers.schema.json#/$defs/id" }
          },
          "mode": { "enum": ["readonly", "write"] },
          "model": { "type": "string", "minLength": 1, "maxLength": 256 },
          "effort": { "enum": ["minimal", "low", "medium", "high", "xhigh", "max"] },
          "timeoutMs": { "type": "integer", "minimum": 10, "maximum": 86400000 },
          "retry": { "$ref": "providers.schema.json#/$defs/retry" },
          "acceptance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command", "args"],
            "properties": {
              "command": { "type": "string", "pattern": "^/", "maxLength": 4096 },
              "args": { "type": "array", "items": { "type": "string" } },
              "timeoutMs": { "type": "integer", "minimum": 10, "maximum": 86400000 },
              "maxOutputBytes": { "type": "integer", "minimum": 256, "maximum": 16777216 },
              "harnessFiles": {
                "type": "array",
                "maxItems": 64,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
              }
            }
          },
          "review": {
            "type": "object",
            "additionalProperties": false,
            "required": ["reviewerProfile", "diff", "testEvidence", "criteria"],
            "properties": {
              "reviewerProfile": { "$ref": "providers.schema.json#/$defs/id" },
              "diff": { "type": "string", "minLength": 1, "maxLength": 1000000 },
              "testEvidence": {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "items": { "type": "object" }
              },
              "criteria": {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "items": { "type": "object" }
              }
            }
          }
        }
      }
    }
  }
}
