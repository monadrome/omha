{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "artifacts", "transcript"],
  "properties": {
    "version": { "const": 1 },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": { "$ref": "providers.schema.json#/$defs/id" },
          "path": { "type": "string", "minLength": 1, "maxLength": 4096 }
        }
      }
    },
    "transcript": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "order", "actor", "kind"],
        "properties": {
          "id": { "$ref": "providers.schema.json#/$defs/id" },
          "order": { "type": "integer", "minimum": 0 },
          "actor": { "enum": ["user", "agent", "host"] },
          "kind": {
            "enum": [
              "objective",
              "requirement",
              "action",
              "produce",
              "feedback",
              "accept",
              "rework",
              "status"
            ]
          },
          "text": { "type": "string", "maxLength": 100000 },
          "artifactId": { "$ref": "providers.schema.json#/$defs/id" },
          "versionId": { "$ref": "providers.schema.json#/$defs/id" },
          "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "replaces": { "$ref": "providers.schema.json#/$defs/id" },
          "requirementIds": {
            "type": "array",
            "items": { "$ref": "providers.schema.json#/$defs/id" }
          },
          "feedbackId": { "$ref": "providers.schema.json#/$defs/id" },
          "causeActionId": { "$ref": "providers.schema.json#/$defs/id" },
          "reason": { "enum": ["missed_requirement", "ordinary_evolution"] },
          "authority": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "policyHash"],
            "properties": {
              "source": { "const": "acceptance" },
              "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "artifactHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "exitCode": { "type": "integer", "minimum": 0, "maximum": 255 }
            }
          }
        }
      }
    }
  }
}
