{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["sourceHandoffId"],
  "oneOf": [{ "required": ["checkpoint"] }, { "required": ["turn"] }],
  "properties": {
    "sourceHandoffId": { "$ref": "providers.schema.json#/$defs/id" },
    "actionId": { "$ref": "providers.schema.json#/$defs/id" },
    "checkpoint": { "type": "string", "minLength": 1, "maxLength": 256 },
    "turn": { "type": "integer", "minimum": 1, "maximum": 1000000 },
    "closeSource": { "type": "boolean", "default": false }
  }
}
