{
  "name": "@huatalk/omha",
  "version": "0.2.0-rc.2",
  "description": "Local, provider-neutral runtime for agent collaboration: routes Claude/Codex/Kimi, validates task DAGs, collects blind roundtable votes, manages owned terminal handoffs, and keeps scoped Markdown memory.",
  "type": "module",
  "bin": {
    "omha": "bin/omha.mjs"
  },
  "files": [
    "bin",
    "lib",
    "hooks",
    "index.mjs",
    "skills",
    "docs",
    "schemas",
    "examples",
    "install.sh",
    ".claude-plugin",
    "README.md",
    "README-zh.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "npm run format:check && npm run validate && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "node scripts/validate.mjs",
    "pack:check": "node scripts/pack-check.mjs",
    "probe:terminals": "node scripts/probe-terminals.mjs"
  },
  "keywords": [
    "claude-code",
    "agent-skills",
    "multi-agent",
    "memory",
    "tmux",
    "cmux",
    "orchestration"
  ],
  "license": "Apache-2.0",
  "author": "HuaTalk (https://github.com/monadrome)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monadrome/omha.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./runner": "./lib/runner.mjs",
    "./memory": "./lib/memory.mjs"
  },
  "directories": {
    "doc": "docs",
    "lib": "lib",
    "test": "tests"
  },
  "bugs": {
    "url": "https://github.com/monadrome/omha/issues"
  },
  "homepage": "https://github.com/monadrome/omha#readme",
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  }
}
